{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "homepage_url": "https://github.com/marchev",
  "description": "Randomized Clockify timesheets generator",
  "default_locale": "en",
  "host_permissions": [
    "https://api.clockify.me/*",
    "https://global.api.clockify.me/*",
    "https://cdn.statically.io/*"
  ],
  "permissions": [
    "notifications",
    "alarms",
    "storage",
    "tabs"
  ],  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "__MSG_extName__",
    "default_icon": {
      "19": "icons/19.png",
      "38": "icons/38.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "browser_style": true
  },  "web_accessible_resources": [{
    "resources": ["icons/*.png", "assets/*", "index.html", "options.html", "js/*.js"],
    "matches": ["<all_urls>"]  }],
  "version": "0.5.5"
}
